{
  "name": "webtune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WebTune - 网页影音收藏与播放歌单浏览器插件",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run typecheck && node scripts/generate-icons.mjs && vite build && vite build --config vite.content.config.ts",
    "test:services": "tsc -p tsconfig.test.json && node scripts/test-services.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
